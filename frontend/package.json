{
  "name": "supportops-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:components": "vitest run",
    "test:e2e": "uv run --locked --project ../backend python ../scripts/test_frontend_e2e.py",
    "test:types": "tsc --noEmit -p tsconfig.tests.json",
    "test:writes": "node --experimental-strip-types --test tests/writes.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:query": "node --experimental-strip-types --test tests/query.test.mjs",
    "test:api": "node --experimental-strip-types --test tests/api.test.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.22.2 <23 || >=24.15.0 <25"
  }
}
