# Local synthetic-data development only. Copy to .env and choose a local password.
POSTGRES_DB=supportops
POSTGRES_USER=supportops
POSTGRES_PASSWORD=replace-with-local-only-password
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
# API/Alembic build their connection URL from POSTGRES_* automatically.
# An explicit DATABASE_URL=postgresql+psycopg://... overrides these fields.
# AI providers arrive in M3.
AI_PROVIDER=mock
# Generate a random secret locally (>=32 bytes); empty means auth is disabled.
JWT_SECRET=
JWT_ISSUER=supportops-api
JWT_AUDIENCE=supportops-web
ACCESS_TOKEN_MINUTES=15
# Local synthetic accounts only. Activation is an explicit separate script.
DEMO_PASSWORD=
EMBEDDING_URL=http://127.0.0.1:11434
# Analysis tool-loop orchestration: handwritten (default) or langgraph. Keep LangSmith tracing variables unset.
ANALYSIS_LOOP=handwritten
